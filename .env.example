# ─── Wallets ───
# Default wallet (used if no --wallet flag)
# Generate: node -e "const w = require(ethers).Wallet.createRandom(); console.log(w.privateKey)"
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Wallets JSON file for mass minting
WALLETS_FILE=./wallets/evm-wallets.json

# ─── RPC Endpoints ───
# Use public RPCs or private (Alchemy/Infura/QuickNode)
RPC_ETHEREUM=https://ethereum.publicnode.com
RPC_BASE=https://mainnet.base.org
RPC_ARBITRUM=https://arb1.arbitrum.io/rpc
RPC_OPTIMISM=https://mainnet.optimism.io
RPC_POLYGON=https://polygon-bor-rpc.publicnode.com
RPC_BSC=https://bsc-dataseed.binance.org
RPC_ZORA=https://rpc.zora.energy
RPC_ROBINHOOD=https://rpc.mainnet.chain.robinhood.com/

# ─── OpenSea API ───
# Get free key: https://docs.opensea.io/reference/api-keys
OPENSEA_API_KEY=your_opensea_api_key_here
OPENSEA_API_BASE=https://api.opensea.io/api/v2

# ─── Reservoir API (optional) ───
RESERVOIR_API_KEY=

# ─── Server ───
PORT=3137


# ─── Webhook Notifications (optional) ───
# Discord webhook URL (https://discord.com/api/webhooks/...)
DISCORD_WEBHOOK_URL=
# Telegram bot (create via @BotFather, get chat id via @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Solana (optional — defaults to public mainnet rpc, rate limited) ───
SOLANA_RPC=

# ─── CAPTCHA (optional — capsolver preferred for speed) ───
CAPSOLVER_API_KEY=
TWOCAPTCHA_API_KEY=

# ─── Social announce (optional) ───
# xurl account name (see ~/tweets)
XURL_POST_ACCT=
